[Unit]
Description=IKEv2 to local SOCKS5 proxy
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/ikev2socks:latest
Pull=never
ContainerName=ikev2socks

AddCapability=NET_ADMIN

Network=pasta

PublishPort=127.0.0.1:1082:1082

Volume=/etc/ipsec.conf:/etc/ipsec.conf:ro
Volume=/etc/ipsec.secrets:/etc/ipsec.secrets:ro

Environment=CONNECTION=example-ikev2
Environment=TIMEOUT=120
Environment=START_DELAY=1
Environment=SOCKS_PORT=1082

StopTimeout=20

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
